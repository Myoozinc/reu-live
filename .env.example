# Copia a .env para uso local con `vercel dev`, o configura en Vercel:
# Project Settings -> Environment Variables.
#
# Con GROQ_API_KEY configurada (gratis en https://console.groq.com/keys), la app usa:
# - IA real para el copiloto y el chat en /api/chat (gpt-oss, Llama 3.3 70B, ...)
# - Whisper real para transcribir el audio grabado en /api/transcribe
# Cada modelo de Groq tiene su propio límite gratuito: si uno se agota, la app pasa al siguiente.
#
# OPENROUTER_API_KEY es opcional, solo se usa como respaldo del chat si Groq falla.

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: cambiar la lista/orden de modelos sin tocar código (separados por comas).
# GROQ_CHAT_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# OPENROUTER_CHAT_MODELS=meta-llama/llama-3.3-70b-instruct:free
