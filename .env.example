# Copia a .env para uso local con `vercel dev`, o configura en Vercel:
# Project Settings -> Environment Variables.
#
# Con GROQ_API_KEY configurada (gratis en https://console.groq.com/keys), la app usa:
# - IA real para el copiloto, el chat y el resumen final en /api/chat (gpt-oss, Llama 3.3 70B, ...)
# - Whisper real para transcribir el audio grabado en /api/transcribe (detecta el idioma)
# - Traducción en vivo (es, en, fr, it, de) con un modelo rápido (Llama 3.1 8B)
# Cada modelo de Groq tiene su propio límite gratuito: si uno se agota, la app pasa al siguiente.
#
# OPENROUTER_API_KEY es opcional, solo se usa como respaldo del chat si Groq falla.

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: cambiar la lista/orden de modelos sin tocar código (separados por comas).
# GROQ_CHAT_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# GROQ_FAST_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile          (traducción en vivo)
# GROQ_REPORT_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b         (resumen final)
# OPENROUTER_CHAT_MODELS=meta-llama/llama-3.3-70b-instruct:free

# Panel de administración (/admin). OBLIGATORIAS: sin ellas el panel queda bloqueado.
# Usa una contraseña nueva y larga, y un secreto aleatorio (por ejemplo: openssl rand -hex 32).
ADMIN_USERNAME=tu_usuario
ADMIN_PASSWORD=una_contraseña_larga_y_nueva
ADMIN_SECRET=cadena_aleatoria_de_64_caracteres
